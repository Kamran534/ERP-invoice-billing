{
  "name": "invoice-billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.test.json",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "start": "turbo run build --filter=@app/api... && pnpm --filter @app/api run start",
    "clean": "turbo run clean && rimraf node_modules coverage",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm docs:check",
    "docs:check": "node scripts/check-docs.mjs docs",
    "db:generate": "pnpm --filter @auth/db exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @auth/db run migrate",
    "db:test:setup": "pnpm --filter @auth/db run test-db:setup",
    "db:migrate:test": "pnpm --filter @auth/db run migrate:test",
    "db:studio": "pnpm --filter @auth/db exec drizzle-kit studio",
    "smoke": "pnpm --filter @app/api run smoke",
    "openapi": "pnpm --filter @app/api run openapi",
    "up": "docker compose up -d --wait",
    "up:obs": "docker compose --profile obs up -d --wait",
    "down": "docker compose down",
    "down:volumes": "docker compose down -v",
    "logs": "docker compose logs -f --tail=100",
    "ps": "docker compose ps",
    "load": "docker compose --profile perf run --rm k6 run /scripts/login.js"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
