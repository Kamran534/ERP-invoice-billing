# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local dev:  cp .env.example .env
# Every value here is validated by a zod schema at boot (apps/api/src/env.ts).
# The process refuses to start on a bad or missing value — no silent defaults
# for anything security-relevant.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host port mapping ───────────────────────────────────────────────────────
# Only affects what docker-compose publishes on the host; container-to-container
# traffic always uses the default ports. Override these when something else on
# your machine already owns 5432/6379/1025/8025 — a second Postgres, another dev
# stack, WSL. Check first with:
#   Get-NetTCPConnection -LocalPort 5432 -State Listen      (PowerShell)
#   ss -ltn '( sport = :5432 )'                             (Linux/macOS)
# ⚑ If you remap this because 5432 is taken, change DATABASE_URL below to match.
# Nothing cross-checks them, and a mismatch connects you to whatever *other*
# project is on 5432 rather than failing — the symptom is an authentication error
# that looks like a credentials problem in this repo.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
ADMINER_PORT=8080
API_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug                 # trace|debug|info|warn|error|fatal
LOG_PRETTY=true                 # false in production — JSON lines for the log pipeline

APP_NAME=Invoice & Billing
APP_ORIGIN=http://localhost:5173   # used to build EVERY emailed link (never the Host header)

# ── Postgres ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://app:app_dev_password@localhost:5432/billing
# ⚑ The integration suite truncates every auth_* table between tests, so it must
# not share a database with your work. `pnpm db:test:setup` creates one and adds
# this line for you; without it the helpers refuse to run rather than wipe the
# database above.
# TEST_DATABASE_URL=postgres://app:app_dev_password@localhost:5432/billing_test
# Pool sizing: total connections across all API replicas must stay below
# postgres max_connections (200 in docker-compose). See README "Scaling".
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000   # server-side kill switch for runaway queries
DB_QUERY_LOG_THRESHOLD_MS=200   # log any query slower than this

# ── Redis (rate limiting, revocation cache, OTP throttles) ──────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=billing:

# ── Mail (Mailpit in dev — catches everything, sends nothing) ───────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Invoice & Billing <no-reply@localhost>"
MAILPIT_API_URL=http://localhost:8025    # dev only, used by the smoke test

# ── Auth / crypto ───────────────────────────────────────────────────────────
# 32-byte base64 key-encryption key. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_KEK=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64==
# Where the tokens live (plan §5.5.6).
#   cookie  httpOnly cookies, nothing in the body — right for a first-party web app
#   bearer  tokens in the body — native apps, cross-origin SPAs
#   both    cookies AND body — handy for Swagger UI and curl
# ⚑ `both` puts the refresh token everywhere a response body goes. Fine locally,
# not in production.
COOKIE_MODE=cookie
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=billing-api
ACCESS_TOKEN_TTL_S=600          # 10m  (plan §5.5.8)
REFRESH_IDLE_TTL_S=2592000      # 30d
REFRESH_ABSOLUTE_TTL_S=7776000  # 90d

# Who may create an organization (plan §10.5).
#   first-user  only while none exists — the first verified account claims the
#               instance and becomes its owner; everyone else joins by invitation
#   anyone      SaaS signup: any verified user without one may create one
#   never       provisioned out of band
# ⚑ `first-user` fails closed on a fresh install. On a deployment that is publicly
# reachable before its first admin signs up, use `never` and provision instead.
ORG_SELF_SERVICE=first-user

# Two-factor authentication (plan §5.4).
MFA_ENABLED=true
MFA_ENFORCE=admins              # optional | admins | all
# ⚑ The riskiest toggle in the module. A remembered device skips the second factor
# for 30 days. It never satisfies step-up and dies on any credential change, but it
# is still a 2FA bypass with a friendly name — off unless you have decided you want it.
MFA_TRUSTED_DEVICES=false

# Have I Been Pwned range check (plan §5.1 step 2). k-anonymity: only the first
# five hex characters of the SHA-1 leave the process.
# ⚑ Off means known-breached passwords are accepted. It exists for air-gapped
# deployments that cannot reach the service, not as a reasonable default — and the
# check already fails open (loudly) when the service is unreachable.
PASSWORD_BREACH_CHECK=true
PASSWORD_BREACH_TIMEOUT_MS=1500

# Argon2id parameters (plan §8.1). Raising memory raises both security AND the
# per-login memory footprint — see HASH_MAX_CONCURRENCY below.
ARGON2_MEMORY_KIB=19456         # 19 MiB
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Hard cap on simultaneous hashes. memory_kib * this = worst-case hashing RAM.
# 19 MiB * 8 = ~152 MiB. Requests beyond the cap queue, then shed with 503.
HASH_MAX_CONCURRENCY=8
HASH_QUEUE_TIMEOUT_MS=2000
# libuv threadpool runs the native argon2 work. Must be >= HASH_MAX_CONCURRENCY
# or hashes queue behind DNS/fs work instead. Default is only 4.
UV_THREADPOOL_SIZE=8

# ── HTTP surface ────────────────────────────────────────────────────────────
# Are clients reaching this API over HTTPS (directly, or via a TLS-terminating
# proxy)? Drives HSTS, CSP upgrade-insecure-requests, Cross-Origin-Opener-Policy
# and the Secure cookie flag — which must never disagree with each other.
# Defaults to true when NODE_ENV=production, false otherwise.
#
# ⚑ Turning this on while actually serving plain HTTP breaks the page for anyone
# not on localhost: every subresource gets rewritten to https:// and fails with
# ERR_SSL_PROTOCOL_ERROR. localhost is exempt as a trustworthy origin, so the
# breakage only appears when someone opens the app from another machine.
HTTPS_ENABLED=false
TRUST_PROXY=false               # true behind a load balancer, else IP limits break
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT_BYTES=65536          # 64 KiB — auth payloads are tiny; keeps DoS surface small
REQUEST_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=15000

# ── API docs ────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true            # ⚑ false in production, or gate it behind auth
SWAGGER_ROUTE_PREFIX=/docs

# ── Observability ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_ROUTE=/metrics
# Load shedding (@fastify/under-pressure): return 503 before the box falls over
MAX_EVENT_LOOP_DELAY_MS=200
MAX_HEAP_USED_BYTES=734003200   # 700 MiB
MAX_RSS_BYTES=943718400         # 900 MiB
